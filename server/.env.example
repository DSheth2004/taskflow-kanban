# MongoDB connection string. Must point at a replica set (Atlas M0 is one) because
# moves, rebalances and the activity log use multi-document transactions.
# Local Docker alternative:
#   mongodb://localhost:27017/taskflow?replicaSet=rs0&directConnection=true
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskflow

PORT=4000

# Comma-separated list of allowed browser origins (leave empty to allow all in dev).
CORS_ORIGIN=http://localhost:5173

# Probability (0..1) that any write request fails with a simulated 500.
# Use it to demo optimistic rollback. Leave at 0 in production.
CHAOS_RATE=0
